{
  "name": "agent-config-manager",
  "version": "0.1.0",
  "private": true,
  "description": "See and manage your Claude Code setup: plugins, skills, agents, MCP servers and hooks.",
  "type": "module",
  "bin": {
    "agent-config": "bin/agent-config.js"
  },
  "files": [
    "bin/",
    "panel/",
    "src/",
    "!src/**/*.test.ts",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/adapters/http/main.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "orca plugin types . >/dev/null && tsc -p .",
    "test:panel": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  }
}
